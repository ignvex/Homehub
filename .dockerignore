# HomeHub .dockerignore
# 排除构建上下文中不需要的文件，加速 docker build

# ── Go 构建产物 ──
bin/
*.exe
*.exe~
*.test
*.out
HomeHub.exe

# ── 本地配置（含凭据，不进入构建上下文）──
config.json
config.local.json
.env
.env.*

# ── 依赖与缓存 ──
node_modules/
web/node_modules/

# ── 前端依赖与废弃构建产物 ──
web/dist-ssr/

# ── 运行时上传与 RSS 图片缓存（镜像内由 mkdir 创建，运行时卷挂载）──
# 只忽略内容，保留目录与 .gitkeep，保证 COPY web/static 有可复制内容
web/static/uploads/*
!web/static/uploads/.gitkeep

# ── IDE / OS ──
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Git ──
.git/
.gitattributes
.gitignore
web/.gitignore

# ── 杂项 ──
data/
*.local
*.log
*.lnk

# ── 文档与工具（非运行时必需） ──
docs/
architecture.json
cache.json
readme.json
README.md
