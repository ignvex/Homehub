{
    "auth": {
        "_comment": "session_secret 必填，至少 32 字符：用 openssl rand -hex 32 生成后替换下面的示例值，不要沿用；password 仅用于首次创建管理员，启动后会被自动清空",
        "password": "",
        "session_secret": "CHANGE_ME_generate_with_openssl_rand_hex_32",
        "username": "admin"
    },
    "balance_monitor": {
        "_comment": "===== 余额监控（仅内存缓存，不入库）=====",
        "_comment_targets": "type 目前仅支持 deepseek",
        "enabled": false,
        "refresh_interval_seconds": 60,
        "targets": []
    },
    "database": {
        "dbname": "homehub",
        "host": "127.0.0.1",
        "password": "",
        "port": 5432,
        "sslmode": "disable",
        "user": "homehub"
    },
    "gravatar": {
        "default_size": 256,
        "default_style": "identicon",
        "enabled": true,
        "max_bytes": 2097152,
        "rating": "g",
        "timeout_seconds": 10,
        "_comment": "extension.enabled 为真时头像经 Extension 代理；否则直连 Gravatar，走 proxy.default。"
    },
    "log": {
        "db_writer": true,
        "format": "colored",
        "level": "info"
    },
    "pastebin": {
        "_comment": "===== 剪贴板（公开 API，无需认证）=====",
        "cleanup_interval_hours": 24,
        "default_ttl_hours": 168,
        "enabled": true,
        "max_content_length": 1048576
    },
    "proxy": {
        "_comment": "===== 全局代理 =====",
        "_comment_entries": "命名代理池。http 类型可用 http_url/https_url 按 scheme 分流；socks5 类型把 host:port 填在 http_url。",
        "_comment_default": "所有出网模块（RSS 抓取、图片缓存、Gravatar、favicon）的默认代理链，按顺序取第一条可用。留空 = 全局直连。Extension 连接不用这个，见 extension.proxy_names。",
        "default": [
            "router"
        ],
        "entries": [
            {
                "enabled": false,
                "http_url": "http://127.0.0.1:7890",
                "https_url": "http://127.0.0.1:7890",
                "name": "dev",
                "type": "http"
            },
            {
                "enabled": false,
                "http_url": "http://127.0.0.1:7890",
                "https_url": "http://127.0.0.1:7890",
                "name": "router",
                "type": "http"
            }
        ]
    },
    "rss": {
        "background_fetch_enabled": true,
        "background_fetch_interval": 300,
        "retention_count": 5000,
        "user_agent": "",
        "fetch_concurrency": 4,
        "fetch_timeout_seconds": 30,
        "image_cache_enabled": true,
        "image_cache_concurrency": 6,
        "image_max_bytes": 134217728,
        "image_cleanup_enabled": true,
        "image_retention_days": 30,
        "image_cleanup_interval_hours": 24,
        "image_allow_private_hosts": false,
        "pikpak": {
            "_comment": "PikPak 离线下载辅助。enabled=false 时相关 API 返回 503；锁定功能不依赖它。client_id/client_secret 由 PikPak 分配，留空则提交会失败并提示。",
            "enabled": false,
            "endpoint": "https://api-drive.mypikpak.com",
            "username": "",
            "password": "",
            "client_id": "",
            "client_secret": "",
            "timeout_seconds": 15,
            "auto_lock": false
        }
    },
    "server": {
        "host": "0.0.0.0",
        "port": 8080
    },
    "webui": {
        "home": {
            "background": {
                "fade_duration_ms": 1000,
                "interval_seconds": 30,
                "mode": "single",
                "selected_asset_ids": [],
                "transition_effect": "fade"
            }
        },
        "login": {
            "background": {
                "fade_duration_ms": 1000,
                "interval_seconds": 30,
                "mode": "single",
                "selected_asset_ids": [],
                "transition_effect": "fade"
            },
            "layout": "center"
        }
    },
    "bookmark": {},
    "extension": {
        "_comment": "===== HomeHub Extension 连接（唯一一处）=====",
        "_comment_base_url": "base_url 必须带 /api/v1 前缀。/hub/*、/fetch、/avatar 都走这个地址。",
        "_comment_key": "私钥用 openssl genpkey -algorithm ed25519 -out hub.key 生成。整份 PEM 粘进 private_key_pem（换行写成 \\n），对应公钥放到 Extension 的 auth.hub.public_key。config.json 权限应设为 600。",
        "_comment_features": "按能力分别开关。默认全关：升级后行为与升级前一致，不会因为新增配置段就把流量改道。",
        "_comment_proxy": "proxy_names 留空 = 直连（默认）。Extension 通常在内网或同机，绕代理反而更慢。",
        "base_url": "https://ext.example.com/api/v1",
        "enabled": false,
        "features": {
            "hub": false,
            "fetch": false,
            "avatar": false
        },
        "private_key_pem": "",
        "proxy_names": [],
        "timeout_seconds": 30
    }
}
