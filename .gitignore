# HomeHub .gitignore

# 二进制输出
bin/
*.exe
*.exe~
# 仅匹配仓库根目录的编译产物；不能写裸 `homehub`，
# 否则会把入口目录 cmd/homehub/ 一并忽略掉。
/homehub

# 数据目录
data/

# 本地配置（含数据库密码、API Key、Cookie 等凭据，禁止提交）
config.json
config.local.json
.env
.env.*
!.env.example

# 运行时上传文件与 RSS 图片缓存（仅保留目录占位）
web/static/uploads/*
!web/static/uploads/.gitkeep

# 日志
*.log

# Windows 快捷方式
*.lnk

# CodeWhale 生成的元数据
readme.json
architecture.json
cache.json

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# CodeWhale
.codewhale/

# Go
*.test
*.out

# Windows 下载标记（NTFS 备用数据流）：跨平台仓库里不该被跟踪
*:Zone.Identifier
