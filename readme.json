{
    "project": "HomeHub",
    "description": "将多种业务融为一体的个人中枢项目，集成导航页面、RSS 订阅、数据可视化等功能。",
    "status": {
        "stage": "研讨阶段",
        "note": "尚未开发，由用户主导推进"
    },
    "deferred": [
        {"item": "数据库表设计", "note": "表结构、索引策略、迁移方案待实现时设计"},
        {"item": "API 接口设计", "note": "路由、请求/响应格式、错误码待实现时设计"},
        {"item": "全文检索", "note": "搜索引擎选型、分词策略待实现时设计"},
        {"item": "用户认证细节", "note": "session 管理、中间件实现待实现时设计"},
        {"item": "日志策略", "note": "日志级别、输出目标、存储周期待实现时设计"},
        {"item": "爬虫功能", "note": "方案待重新设计"},
        {"item": "前端交互细节", "note": "开发环境已搭建，页面实现进行中"},
        {"item": "数据可视化", "note": "Chart.js 已集成，仪表盘指标定义待实现时设计"}
    ],
    "constraints": {
        "explicitly_excluded": {
            "health_check_endpoint": "Unraid 面板已覆盖",
            "notification_push": "用户定期主动访问，暂不需要",
            "api_rate_limiting": "个人使用，无滥用风险",
            "multi_user_registration": "单用户场景"
        },
        "runtime_environment": {
            "os": "Unraid",
            "deployment": "Docker 容器或直接运行二进制",
            "database": "外部 PostgreSQL 服务器",
            "web_port": 8080
        },
        "technical_stack": {
            "language": "Go 1.26",
            "http_framework": "Gin",
            "orm": "GORM + pgx",
            "database": "PostgreSQL（已部署）",
            "frontend": "Vite + React + TypeScript + HTMX",
            "charts": "Chart.js",
            "rss_parser": "gofeed",
            "password_hash": "bcrypt",
            "css": "CSS3 + CSS 变量暗色模式 + CSS Modules"
        },
        "configuration": {
            "file": "config.json",
            "hot_reload": true,
            "concurrency": "sync.RWMutex",
            "schema": ["server", "database", "auth", "log"]
        },
        "deployment": {
            "dockerfile": "多阶段构建 golang:1.26-alpine → alpine:latest",
            "build_command": "CGO_ENABLED=0 go build -o homehub .",
            "exposed_port": 8080
        }
    },
    "project_structure": {
        "entry": "main.go（根目录）",
        "source": "internal/（config、server、handler、middleware、model、service、rss、search、logger）",
        "web": "web/（Vite + React 前端项目）",
        "config": "config.json（根目录）"
    },
    "development_conventions": {
        "golang_standard": "阿里巴巴 Golang 编码规范",
        "layering": "handler → service → model",
        "database": "GORM 为主，复杂查询可用原生 SQL",
        "frontend": "Vite + React + HTMX 群岛架构，HMR 热更新",
        "dark_mode": "CSS 变量，[data-theme='dark']",
        "config": "sync.RWMutex 保护热加载"
    }
}
